# =====================================================================
# 全仓库唯一的忽略规则（子目录不再单独放 .gitignore）。
# 模式不含路径分隔符时对任意层级生效，例如 `dist/` 同时覆盖
# EchoMindFrontend/dist/ 与后端 Python 构建产物。
# =====================================================================

# WorkBuddy 工作数据：审计记录、记忆日志、临时冒烟脚本，不是项目源码
.workbuddy/

# 环境变量（含密钥，任何目录，含 EchoMind/.env）
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
*.sqlite3

# Node / 前端
node_modules/

# 构建产物（前端 dist、后端 Python dist/build）
dist/
build/

# 运行时数据与日志（ChromaDB 索引、评测结果、运行日志）
data/
logs/
*.log

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# Docker 构建脚本的重复副本（如 build-image(1).sh）。
# 注意：脚本本身必须入库，下面的取消忽略规则不能删——
# 否则新克隆的仓库里 build-image*.sh 会把 build-image.sh 一起挡掉，
# 换机器后会缺少镜像构建脚本。
build-image*.sh
!build-image.sh

# 备份文件
*~
*.bak
docker-compose(1).yml

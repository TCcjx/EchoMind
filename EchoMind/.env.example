# EchoMind 环境变量示例
# 复制为 .env 后填写真实值: cp .env.example .env
# docker compose 部署时会自动读取同目录下的 .env

# ── Anthropic / DeepSeek（必填）─────────────────────────────────────────────────
# 直接使用 Anthropic 官方 API 时填官方 key，MODEL 保持默认即可
# 使用 DeepSeek 等兼容 Anthropic 协议的第三方服务时，按注释示例填写 BASE_URL 和 MODEL
ANTHROPIC_API_KEY=sk-xxx-your-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis（工作记忆）───────────────────────────────────────────────────────────
# docker compose 内部地址（容器间通信）；本机裸跑时改为 redis://localhost:6379/0
REDIS_PASSWORD=change-me-if-you-like
REDIS_URL=redis://:${REDIS_PASSWORD:-change-me-if-you-like}@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）──────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务，容器内端口 8000）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时自动切换）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── Skills 动态加载（可选，默认使用项目内 skills/ 目录）────────────────────────
# ECHOMIND_SKILLS_DIR=/app/skills
# ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 监控 ──────────────────────────────────────────────────────────────────────
# 应用内置 Prometheus 指标服务端口；0 或留空 = 不启动（Prometheus 服务器仍可通过 /metrics 抓取）
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
# 告警 webhook（如飞书/企业微信机器人），留空 = 不告警
ALERT_WEBHOOK_URL=

# ── 评测（可选，默认使用容器内路径）─────────────────────────────────────────────
# EVAL_BASELINE_PATH=/app/data/eval/baseline.json
